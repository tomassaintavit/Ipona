# API key de api-sports.io (plan B de datos deportivos alternativos).
# Hoy no es el proveedor principal; el proyecto usa ESPN vía adaptador propio.
# Obtené una key gratis en https://api.sports.io
API_SPORTS=

# Clave de API de Cerebras (proveedor LLM).
# Registrate en https://cloud.cerebras.ai y generá tu key personal.
CEREBRAS_API_KEY=

# Clave de API de Groq (proveedor LLM alternativo / failover).
# Obtenela en https://console.groq.com y agreguela al SDK OpenAI.
GROQ_API_KEY=

# Secreto JWT para firmar tokens de sesión.
# Obligatorio: generá uno nuevo con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Nunca compartas este valor en repositorios públicos.
SECRET_KEY=

# Código de invitación obligatorio para el registro de nuevos usuarios.
# Si dejás este campo vacío, el registro quedará deshabilitado (solo admin).
INVITE_CODE=

# URL de conexión a la base de datos PostgreSQL de Supabase.
# Formato: postgresql+asyncpg://usuario:password@db.host.supabase.com:5432/postgres
DATABASE_URL=

# Habilita o deshabilita los jobs automáticos (APScheduler).
# true = el scheduler ejecuta sync de eventos, predicciones y resultados cada hora.
# false = los jobs deben dispararse manualmente vía curl a los endpoints.
SCHEDULER_ENABLED=true

# Versión de Python con la que fue desarrollado y testeado el proyecto.
# Útil para entornos de desarrollo aislados (pyenv, venv, Docker).
PYTHON_VERSION=3.12.8